<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from the INFOPLIST_KEY_* build settings. Lets
	     Compose render at 120Hz on ProMotion iPhones, as Compose Multiplatform recommends. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Only standard HTTPS (exempt), so App Store Connect needn't ask about export compliance per build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
